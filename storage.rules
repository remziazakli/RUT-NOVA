rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Max file sizes
    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPDFOrImage() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    // Profile photos
    match /users/{uid}/profile/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) && isImage() && isUnder5MB();
    }

    // Meal log photos
    match /mealLogs/{uid}/{logId}/{fileName} {
      allow read: if isAuthenticated() && (
        request.auth.uid == uid ||
        request.auth.token.admin == true
      );
      allow write: if isOwner(uid) && isImage() && isUnder10MB();
    }

    // Question uploads (photos or PDFs)
    match /questions/{uid}/{questionId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) && isPDFOrImage() && isUnder10MB();
    }

    // Question responses (teacher uploads)
    match /questionResponses/{teacherId}/{responseId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isPDFOrImage() && isUnder10MB();
    }

    // System assets (logo, etc.) - admin only write
    match /system/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
